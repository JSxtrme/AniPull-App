<?xml version="1.0" encoding="utf-8"?>
<!-- 1.9-dev5.0: FileProvider paths for the in-app updater — the
     downloaded APK lives in cacheDir/updates/ and is handed to
     Android's installer via a content:// URI.
     2.0-dev1.0: also serves completed downloads (below). -->
<paths>
    <cache-path name="updates" path="updates/" />
    <!-- 2.0-dev1.0: completed downloads live in
         getExternalFilesDir(DIRECTORY_DOWNLOADS)/Anipull/ and are
         opened via FileProvider (ACTION_VIEW, video/mp4). -->
    <external-files-path name="downloads" path="Download/Anipull/" />
</paths>
